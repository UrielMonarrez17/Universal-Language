  m_text: "<b>PLATS</b>\nCroque-monsieur \xB7 12 \u20AC  <i>(jambon, fromage)</i>\nQuiche
    lorraine \xB7 13 \u20AC  <i>(lardons, cr\xE8me)</i>\nSalade ni\xE7oise \xB7 11
    \u20AC  <i>(thon, tomates, olives)</i>\nSoupe \xE0 l'oignon \xB7 10 \u20AC  <i>(gratin\xE9e)</i>\n\n<b>BOISSONS</b>\nEau
    plate / gazeuse \xB7 3 \u20AC\nCaf\xE9 \xB7 3 \u20AC   |   Caf\xE9 cr\xE8me \xB7
    4 \u20AC\nTh\xE9 (menthe / citron) \xB7 4 \u20AC\nJus d'orange press\xE9 \xB7
    5 \u20AC\n\n<b>DESSERTS</b>\nCroissant \xB7 3 \u20AC   |   Cr\xE8me br\xFBl\xE9e
    \xB7 7 \u20AC"
